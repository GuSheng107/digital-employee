# ========================
# Share 服务调用
# ========================
# 网关不持有数据库、Redis、MinIO、RabbitMQ 的地址或凭证。
BACKEND_DATA_BASE_URL=http://127.0.0.1:8010
BACKEND_DATA_API_KEY=
STORAGE_OBJECT_MAX_SIZE_BYTES=20971520
BACKEND_AUTH_BASE_URL=http://127.0.0.1:8020
BACKEND_DATA_RETRY_SECONDS=5

# ========================
# 服务配置
# ========================
APP_ENV=production
GATEWAY_PORT=8864
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# ========================
# 服务间内部令牌
# ========================
# backend-auth CRUD 落库后用此令牌经 X-Internal-Token 头触发 Gateway /admin/reload。
# 不转发用户 token：reload 是服务间编排动作，与最终用户权限解耦。
# 必须配置，否则 reload 端点 fail-closed 拒绝所有请求。
INTERNAL_ADMIN_TOKEN=

# ========================
# Nacos 配置中心
# ========================
NACOS_SERVER_ADDR=127.0.0.1:8848
NACOS_USERNAME=
NACOS_PASSWORD=
NACOS_NAMESPACE=prod
# NACOS_DATA_ID=prod.yaml
# NACOS_GROUP=DEFAULT_GROUP
# NACOS_TIMEOUT=5.0

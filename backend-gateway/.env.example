# ========================
# RabbitMQ 配置 (三期引入)
# ========================
# RabbitMQ 格式：amqp://账号:密码@主机地址:端口/
RABBITMQ_URL=amqp://user:password@localhost:5672/
# 交换机名称
RABBITMQ_EXCHANGE=bot.topic.exchange
# 供后端 Agent 消费的入站队列名称
RABBITMQ_INBOUND_QUEUE=q_inbound_to_agent
# 供当前网关消费的出站队列名称
RABBITMQ_OUTBOUND_QUEUE=q_outbound_to_gateway
# 网关发布入站消息使用的路由键前缀
RABBITMQ_INBOUND_PUBLISH_PREFIX=msg.inbound
# 入站队列绑定的路由键（基于发布前缀自动拼接）
RABBITMQ_INBOUND_ROUTING_KEY="${RABBITMQ_INBOUND_PUBLISH_PREFIX}.#"
# 出站队列绑定的路由键
RABBITMQ_OUTBOUND_ROUTING_KEY=msg.outbound.#


# ========================
# MinIO 对象存储配置 (二期引入)
# ========================
# API 通信端点 (注意：必须是 API 端口，非网页端端口)
MINIO_ENDPOINT=your_minio_endpoint_ip_or_domain:19000
# 是否启用 HTTPS
MINIO_SECURE=false
# 访问凭证 (对应 Minio Root 账号或专属 Service Account)
MINIO_ACCESS_KEY=your_minio_access_key
MINIO_SECRET_KEY=your_minio_secret_key
# 系统默认读写存储桶 (需提前在控制台创建完毕)
MINIO_BUCKET_NAME=your_file_bucket_name


# ========================
# Admin API 鉴权配置
# ========================
# 保护 /api/v1/admin/* 路由的 API Key。
# 留空时跳过校验；生产环境务必配置。
# 客户端需通过请求头 X-API-Key: <值> 携带。
GATEWAY_ADMIN_API_KEY=


# ========================
# Nacos 配置中心 (可选)
# ========================
# 启动时从 Nacos 拉取共享基础设施配置（RabbitMQ/MinIO 等），优先级高于本地 .env。
# NACOS_SERVER_ADDR 未配置时跳过拉取，使用本地配置。
# 配置 dataId 默认为 ${NACOS_NAMESPACE}.yaml（即 dev.yaml / prod.yaml），DEFAULT_GROUP。
# 凭证不入库不入 Nacos，仅从环境变量读取，避免循环依赖。
NACOS_SERVER_ADDR=
NACOS_USERNAME=
NACOS_PASSWORD=
NACOS_NAMESPACE=dev
# NACOS_DATA_ID=dev.yaml
# NACOS_GROUP=DEFAULT_GROUP
# NACOS_TIMEOUT=5.0

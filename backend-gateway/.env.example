# ========================
# Share 服务调用
# ========================
# 网关不持有数据库、Redis、MinIO、RabbitMQ 的地址或凭证。
BACKEND_DATA_BASE_URL=http://127.0.0.1:8010
BACKEND_DATA_API_KEY=
STORAGE_OBJECT_MAX_SIZE_BYTES=20971520
BACKEND_AUTH_BASE_URL=http://127.0.0.1:8020
BACKEND_DATA_MESSAGE_POLL_SECONDS=20
BACKEND_DATA_RETRY_SECONDS=5

# ========================
# 服务配置
# ========================
GATEWAY_PORT=8864
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# ========================
# Nacos 配置中心
# ========================
NACOS_SERVER_ADDR=127.0.0.1:8848
NACOS_USERNAME=
NACOS_PASSWORD=
NACOS_NAMESPACE=dev
# NACOS_DATA_ID=dev.yaml
# NACOS_GROUP=DEFAULT_GROUP
# NACOS_TIMEOUT=5.0

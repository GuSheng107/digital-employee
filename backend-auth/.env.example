APP_NAME=Digital Employee Auth
APP_VERSION=0.1.0
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8020
API_PREFIX=/api/v1
DEPENDENCY_TIMEOUT_SECONDS=3
# 保护业务端点的 API Key；未配置时服务按 fail-closed 拒绝业务访问。
# 客户端需通过请求头 X-API-Key: <值> 携带。
API_KEY=

# ========================
# backend-data 客户端配置
# ========================
# backend-data 服务地址（唯一基础设施数据访问入口）
BACKEND_DATA_BASE_URL=http://127.0.0.1:8010
BACKEND_DATA_API_KEY=

# ========================
# 账号输入规则
# ========================
# 当前仅支持中国大陆号码；未来出海时切换为对应 ISO 3166-1 alpha-2 地区码。
PHONE_DEFAULT_REGION=CN

# ========================
# 认证接口限流
# ========================
# 固定窗口计数由 backend-data 的 Redis 执行，backend-auth 仅传递限流策略。
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_SECONDS=60
REGISTER_RATE_LIMIT=5
REGISTER_RATE_WINDOW_SECONDS=300

CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173


# ========================
# Nacos 配置中心
# ========================
# 可选：拉取 backend-auth 自身配置；基础设施连接配置仍只由 backend-data 持有。
NACOS_SERVER_ADDR=
NACOS_USERNAME=
NACOS_PASSWORD=
NACOS_NAMESPACE=dev
# NACOS_DATA_ID=prod.yaml
# NACOS_GROUP=DEFAULT_GROUP
# NACOS_TIMEOUT=5.0

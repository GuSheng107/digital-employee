APP_NAME=Digital Employee Auth
APP_VERSION=0.1.0
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8020
API_PREFIX=/api/v1
DEPENDENCY_TIMEOUT_SECONDS=3
# 保护业务端点的 API Key，留空时跳过校验；生产环境必须配置。
# 客户端需通过请求头 X-API-Key: <值> 携带。
API_KEY=

# ========================
# backend-data 客户端配置
# ========================
# backend-data 服务地址（用于文件上传等基础设施访问）
BACKEND_DATA_BASE_URL=http://127.0.0.1:8010
BACKEND_DATA_API_KEY=

# ========================
# 双 Token 配置
# ========================
# access_token 有效期（秒），默认 30 分钟
ACCESS_TOKEN_TTL_SECONDS=1800
# refresh_token 有效期（秒），默认 7 天
REFRESH_TOKEN_TTL_SECONDS=604800
# Redis key 前缀
TOKEN_REDIS_PREFIX=auth

# ========================
# 本地回退配置（Nacos 不可达时使用）
# 正常启动会从 Nacos prod.yaml 拉取以下配置并覆盖，这里只是兜底默认值。
# ========================
CORE_DB_HOST=106.54.60.80
CORE_DB_PORT=15432
CORE_DB_NAME=db_data
CORE_DB_USER=app_usr
CORE_DB_PASSWORD=AppUsr@2026
CORE_DB_SSLMODE=disable

REDIS_HOST=106.54.60.80
REDIS_PORT=16379
REDIS_DB=0
REDIS_USERNAME=app_usr
REDIS_PASSWORD=AppUsr@2026
REDIS_SSL=false

CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173


# ========================
# Nacos 配置中心
# ========================
# 启动时从 Nacos 拉取共享基础设施配置（DB/Redis 等），优先级高于本地 .env。
# 配置 dataId 默认为 ${NACOS_NAMESPACE}.yaml（即 prod.yaml / dev.yaml），DEFAULT_GROUP。
# 凭证不入库不入 Nacos，仅从环境变量读取，避免循环依赖。
NACOS_SERVER_ADDR=106.54.60.80:18848
NACOS_USERNAME=test
NACOS_PASSWORD=test123456
NACOS_NAMESPACE=prod
# NACOS_DATA_ID=prod.yaml
# NACOS_GROUP=DEFAULT_GROUP
# NACOS_TIMEOUT=5.0

APP_NAME=Digital Employee Data Platform
APP_VERSION=0.1.0
APP_ENV=local
APP_HOST=127.0.0.1
APP_PORT=8000
API_PREFIX=/api/v1
AUTO_CREATE_TABLES=true
DEPENDENCY_TIMEOUT_SECONDS=3

CORE_DB_HOST=127.0.0.1
CORE_DB_PORT=5432
CORE_DB_NAME=digital_employee_core
CORE_DB_USER=postgres
CORE_DB_PASSWORD=your_password
CORE_DB_SSLMODE=disable

VECTOR_DB_HOST=127.0.0.1
VECTOR_DB_PORT=5432
VECTOR_DB_NAME=digital_employee_vector
VECTOR_DB_USER=postgres
VECTOR_DB_PASSWORD=your_password
VECTOR_DB_SSLMODE=disable

DDL_DATABASE_URL=postgresql+psycopg2://ddl_user:your_password@127.0.0.1:5432/digital_employee_core?sslmode=disable
DDL_ALLOWED_DATABASE=digital_employee_core
DDL_ALLOWED_SCHEMAS=public
DDL_EXECUTION_ENABLED=false

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_SSL=false

MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_DEFAULT_BUCKET=digital-employee
# Compatible with the gateway branch naming; use either one.
# MINIO_BUCKET_NAME=digital-employee

CORS_ORIGINS=http://127.0.0.1:5174,http://localhost:5174,http://101.37.69.110:5174

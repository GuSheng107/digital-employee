# ========================
# Nacos 配置中心 (可选，预留接入)
# ========================
# backend-agent 当前无基础设施配置（DB/Redis/MinIO/RabbitMQ）可读，
# 此处为未来转 Postgres 或接入其他基础设施时的预留入口。
#
# 注意：backend-agent 未安装 python-dotenv，本文件不会被自动加载，
# 实际部署时需将以下变量设为系统环境变量。
#
# 启动时若 NACOS_SERVER_ADDR 已配置，会从 Nacos 拉取配置注入 os.environ，
# 优先级高于本地默认值；失败时静默降级。
# 配置 dataId 默认为 ${NACOS_NAMESPACE}.yaml（即 dev.yaml / prod.yaml），DEFAULT_GROUP。
NACOS_SERVER_ADDR=
NACOS_USERNAME=
NACOS_PASSWORD=
NACOS_NAMESPACE=dev
# NACOS_DATA_ID=dev.yaml
# NACOS_GROUP=DEFAULT_GROUP
# NACOS_TIMEOUT=5.0

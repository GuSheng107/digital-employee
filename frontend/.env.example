# 前端 production 环境变量示例
# 复制为 .env 并按需修改
VITE_APP_ENV=production

# ===== 浏览器侧：axios baseURL（前端请求类读取）=====

# backend-auth API 基础路径
# 一键启动的 production preview 默认走 Vite proxy，无需设置
# 该值必须包含 /api/v1；直连示例：http://127.0.0.1:8020/api/v1
# VITE_BACKEND_AUTH_API_BASE_URL=/backend-auth-api/api/v1

# 数据中台 API 基础路径
# 一键启动的 production preview 默认走 Vite proxy，无需设置
# 生产环境或直连后端时设置为 http://127.0.0.1:8010
# VITE_DATA_PLATFORM_API_BASE_URL=/data-platform-api

# ===== 本地 production preview 代理目标地址（vite.config.ts 读取）=====

# backend-auth 代理目标（开发环境）
VITE_BACKEND_AUTH_TARGET=http://127.0.0.1:8020

# 数据中台代理目标（开发环境）
VITE_DATA_PLATFORM_TARGET=http://127.0.0.1:8010

# 当前开放注册的手机号地区（ISO 3166-1 alpha-2）。
# 当前仅支持中国大陆；出海时按部署环境切换，无需修改号码段代码。
VITE_PHONE_DEFAULT_REGION=CN

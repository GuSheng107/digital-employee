# ========================
# Nacos 配置中心（必填）
# ========================
# 启动时从 Nacos 拉取所有基础设施配置（DB/Redis/MinIO/RabbitMQ 等），
# Nacos 不可用时服务将直接退出。
NACOS_SERVER_ADDR=127.0.0.1:8848
NACOS_USERNAME=
NACOS_PASSWORD=
NACOS_NAMESPACE=prod
# NACOS_DATA_ID=prod.yaml
# NACOS_GROUP=DEFAULT_GROUP
# NACOS_TIMEOUT=5.0
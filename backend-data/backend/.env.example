APP_NAME=Digital Employee Data Platform
APP_VERSION=0.1.0
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8010
API_PREFIX=/api/v1
DEPENDENCY_TIMEOUT_SECONDS=3
# 保护业务端点的 API Key；未配置时服务按 fail-closed 拒绝业务访问。
# 客户端需通过请求头 X-API-Key: <值> 携带。
API_KEY=

# ========================
# app_secret 加密主密钥
# ========================
# Bot 的 app_secret 用 Fernet 可逆加密后落库（密文带 enc:v1: 前缀），
# Gateway 拉取活跃 Bot 时由 service 层解密为明文返回。
# 此处填一个足够长的随机字符串作为 passphrase（PBKDF2 派生 Fernet 密钥）。
# 不入 Nacos，仅从环境变量读取（遵循凭证安全约束）。
APP_SECRET_KEY=

# ========================
# 本地回退配置（Nacos 不可达时使用）
# 正常启动会从 Nacos prod.yaml 拉取以下配置并覆盖，这里只是兜底默认值。
# ========================
CORE_DB_HOST=127.0.0.1
CORE_DB_PORT=5432
CORE_DB_NAME=digital_employee_core
CORE_DB_USER=digital_employee_app
CORE_DB_PASSWORD=
CORE_DB_SSLMODE=disable

VECTOR_DB_HOST=127.0.0.1
VECTOR_DB_PORT=5432
VECTOR_DB_NAME=digital_employee_vector
VECTOR_DB_USER=digital_employee_app
VECTOR_DB_PASSWORD=
VECTOR_DB_SSLMODE=disable

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_SSL=false

MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_SECURE=false
MINIO_DEFAULT_BUCKET=digital-employee

# ========================
# 身份域 Redis 状态
# ========================
TOKEN_REDIS_PREFIX=auth
ACCESS_TOKEN_TTL_SECONDS=1800
REFRESH_TOKEN_TTL_SECONDS=604800
PASSWORD_CHANGE_REDIS_PREFIX=auth:password-change-required
CAPTCHA_REDIS_PREFIX=auth:captcha
CAPTCHA_TTL_SECONDS=120
INVITE_CODE_REDIS_PREFIX=invite_code
INVITE_CODE_DEFAULT_TTL_SECONDS=604800
MESSAGE_RELAY_REDIS_PREFIX=message-relay
MESSAGE_RELAY_TTL_SECONDS=604800
MESSAGE_LEASE_SECONDS=60
MESSAGE_MAX_DELIVERY_ATTEMPTS=5
MESSAGE_DEAD_LETTER_LIMIT=1000

# ========================
# RabbitMQ（仅 backend-data 持有连接）
# ========================
RABBITMQ_URL=amqp://guest:guest@127.0.0.1:5672/
STORAGE_OBJECT_MAX_SIZE_BYTES=20971520
RABBITMQ_EXCHANGE=bot.topic.exchange
RABBITMQ_INBOUND_QUEUE=q_inbound_to_agent
RABBITMQ_OUTBOUND_QUEUE=q_outbound_to_gateway
RABBITMQ_INBOUND_PUBLISH_PREFIX=msg.inbound
RABBITMQ_INBOUND_ROUTING_KEY=msg.inbound.#
RABBITMQ_OUTBOUND_ROUTING_KEY=msg.outbound.#
RABBITMQ_PREFETCH_COUNT=20

CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173


# ========================
# Nacos 配置中心
# ========================
# 启动时从 Nacos 拉取共享基础设施配置（DB/Redis/MinIO 等），优先级高于本地 .env。
# 配置 dataId 默认为 ${NACOS_NAMESPACE}.yaml（即 prod.yaml / dev.yaml），DEFAULT_GROUP。
# 凭证不入库不入 Nacos，仅从环境变量读取，避免循环依赖。
NACOS_SERVER_ADDR=127.0.0.1:8848
NACOS_USERNAME=
NACOS_PASSWORD=
NACOS_NAMESPACE=prod
# NACOS_DATA_ID=prod.yaml
# NACOS_GROUP=DEFAULT_GROUP
# NACOS_TIMEOUT=5.0

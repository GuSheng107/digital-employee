APP_NAME=Digital Employee Data Platform
APP_VERSION=0.1.0
APP_ENV=local
APP_HOST=127.0.0.1
APP_PORT=8010
API_PREFIX=/api/v1
DEPENDENCY_TIMEOUT_SECONDS=3
# 保护业务端点的 API Key，留空时跳过校验；生产环境必须配置。
# 客户端需通过请求头 X-API-Key: <值> 携带。
API_KEY=

CORE_DB_HOST=127.0.0.1
CORE_DB_PORT=5432
CORE_DB_NAME=digital_employee_core
CORE_DB_USER=digital_employee_app
CORE_DB_PASSWORD=your_password
CORE_DB_SSLMODE=disable

VECTOR_DB_HOST=127.0.0.1
VECTOR_DB_PORT=5432
VECTOR_DB_NAME=digital_employee_vector
VECTOR_DB_USER=digital_employee_app
VECTOR_DB_PASSWORD=your_password
VECTOR_DB_SSLMODE=disable

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_SSL=false

MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=your_minio_access_key
MINIO_SECRET_KEY=your_minio_secret_key
MINIO_SECURE=false
MINIO_DEFAULT_BUCKET=digital-employee
# Compatible with the gateway branch naming; use either one.
# MINIO_BUCKET_NAME=digital-employee

CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173


# ========================
# Nacos 配置中心 (可选)
# ========================
# 启动时从 Nacos 拉取共享基础设施配置（DB/Redis/MinIO 等），优先级高于本地 .env。
# NACOS_SERVER_ADDR 未配置时跳过拉取，使用本地配置。
# 配置 dataId 默认为 ${NACOS_NAMESPACE}.yaml（即 dev.yaml / prod.yaml），DEFAULT_GROUP。
# 凭证不入库不入 Nacos，仅从环境变量读取，避免循环依赖。
NACOS_SERVER_ADDR=
NACOS_USERNAME=
NACOS_PASSWORD=
NACOS_NAMESPACE=dev
# NACOS_DATA_ID=dev.yaml
# NACOS_GROUP=DEFAULT_GROUP
# NACOS_TIMEOUT=5.0
